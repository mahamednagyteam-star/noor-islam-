{
  "expo": {
    "name": "نور الإسلام",
    "slug": "noor-islam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.noorislam.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.noorislam.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لحساب اتجاه القبلة ومواقيت الصلاة.",
        "NSMicrophoneUsageDescription": "يستخدم التطبيق الميكروفون لتحويل كلامك إلى نص عند اختيار البحث الصوتي.",
        "NSSpeechRecognitionUsageDescription": "يستخدم التطبيق التعرف على الكلام للبحث عن آيات وأذكار تطلبها صوتيًا."
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/adhan/adhan.mp3",
            "./assets/adhan/fajr.mp3"
          ]
        }
      ],
      "./plugins/withPrayerWidget"
    ]
  }
}
