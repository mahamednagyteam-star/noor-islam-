{
  "expo": {
    "name": "نور الإسلام",
    "slug": "noor-islam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "ios", "web"],
    "android": {
      "package": "com.noorislam.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
