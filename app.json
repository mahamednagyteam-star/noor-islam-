    "ios": {
      "bundleIdentifier": "com.noorislam.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لحساب اتجاه القبلة ومواقيت الصلاة."
      }
    }
  }
}