{
  "name": "noor-islam",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prepare:data": "node scripts/prepare-data.mjs",
    "prebuild:android": "npm run prepare:data && npx expo prebuild --platform android --non-interactive",
    "build:android": "npm run prebuild:android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-av": "~15.0.2",
    "expo-location": "~18.0.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "expo-notifications": "~0.29.14",
    "expo-file-system": "~18.0.12",
    "adhan": "^4.4.3",
    "expo-asset": "~11.0.5",
    "expo-system-ui": "~4.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
